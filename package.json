{
  "name": "scale-trainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.worker.json",
